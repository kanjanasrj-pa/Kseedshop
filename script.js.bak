function uid(prefix = "ID") {
  return prefix + Date.now().toString().slice(-8) +
    Math.floor(Math.random() * 1000);
}

function money(value) {
  return Number(value).toLocaleString("th-TH") + " ฿";
}

function escapeHTML(value = "") {
  return String(value).replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#039;"
  })[char]);
}

function getUsers() {
  return read(DB.users, []);
}

function getProducts() {
  return read(DB.products, []);
}

function getOrders() {
  return read(DB.orders, []);
}

function getCart() {
  return read(DB.cart, []);
}

function getChats() {
  return read(DB.chats, []);
}

function getUserById(id) {
  return getUsers().find(user => user.id === id);
}

function isSeller() {
  return currentUser && currentUser.role === "seller";
}

function requireLogin() {
  if (!currentUser) {
    showPage("auth");
    toast("กรุณาเข้าสู่ระบบก่อน");
    return false;
  }
  return true;
}

function toast(message) {
  const box = $("toast");
  box.textContent = message;
  box.classList.add("show");

  clearTimeout(window.toastTimer);
  window.toastTimer = setTimeout(() => {
    box.classList.remove("show");
  }, 2500);
}

function updateNavbar() {
  const cartCount = getCart().reduce(
    (sum, item) => sum + item.quantity, 0
  );

  $("cartCount").textContent = cartCount;
  $("loginNav").classList.toggle("hidden", !!currentUser);
  $("logoutNav").classList.toggle("hidden", !currentUser);
}

function showPage(page) {
  if (page === "seller" && !isSeller()) {
    toast("เฉพาะบัญชีผู้ขายเท่านั้น");
    return;
  }

  if (["cart", "checkout", "orders", "profile", "chat"].includes(page)
      && !requireLogin()) return;

  currentPage = page;

  const pages = {
    home: renderHome,
    auth: renderAuth,
    cart: renderCart,
    checkout: renderCheckout,
    orders: renderOrders,
    profile: renderProfile,
    chat: renderChat,
    seller: renderSeller
  };

  (pages[page] || renderHome)();
  updateNavbar();
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function logout() {
  if (!currentUser) return;

  currentUser = null;
  localStorage.removeItem(DB.session);
  save(DB.cart, []);
  selectedChat = null;

  updateNavbar();
  showPage("home");
  toast("ออกจากระบบเรียบร้อย");
}

